[Unit]
Description=Mochizuki PVR operator
Documentation=https://github.com/Chinachu/Chinachu
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/mochizuki
ExecStart=/opt/mochizuki/mochizuki run operator
Restart=on-failure
RestartSec=5s
KillSignal=SIGINT
TimeoutStopSec=30s

# Uncomment if you want systemd, rather than Mochizuki PVR config uid/gid, to set
# the service account. Ensure /opt/mochizuki, data/, log/, and recorded files
# are writable by this user.
# User=mochizuki
# Group=mochizuki

NoNewPrivileges=false
PrivateTmp=true

[Install]
WantedBy=multi-user.target
