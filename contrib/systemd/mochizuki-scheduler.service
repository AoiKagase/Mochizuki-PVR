[Unit]
Description=Mochizuki PVR scheduler
Documentation=https://github.com/Chinachu/Chinachu
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/mochizuki
ExecStart=/opt/mochizuki/mochizuki run scheduler
TimeoutStartSec=30min

# The scheduler is a short-lived job. Add User=/Group= here only if the working
# directory, data/, log/, and configured recorded directory are writable by that
# user.
# User=mochizuki
# Group=mochizuki

NoNewPrivileges=false
PrivateTmp=true
